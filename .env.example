# GLOFGuard AI Environment Configuration
PROJECT_NAME="GLOFGuard AI"
API_V1_STR="/api"
HOST="0.0.0.0"
PORT=8000
DATABASE_URL="sqlite:///./glofguard.db"

# GenAI Settings
# 1. Local Ollama:
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"

# 2. Google Gemini API (leave blank to use offline deterministic SOP fallback):
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

# Simulation defaults
SIMULATION_INTERVAL_SEC=2.0
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
